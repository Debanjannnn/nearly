# cp .env.example .env. Never commit .env. docker compose reads it; host runs (make api, ...) need it exported.

# network: testnet | mainnet (mainnet only for the Intents flow)
NEAR_NETWORK=testnet
RPC_URL=https://test.rpc.fastnear.com
ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org
# root account that owns the factory, e.g. nearly.testnet (scripts/deploy-testnet.sh)
NEARLY_ROOT_ACCOUNT=

# executor function-call key; EXECUTOR_PUBLIC_KEY is the ed25519:... public half
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=
EXECUTOR_PUBLIC_KEY=
# shared by api, scheduler and executor (X-Internal-Secret), e.g. openssl rand -hex 32
INTERNAL_SECRET=
# per-step USD cap enforced by the executor
MAX_STEP_USD=100
# optional: Rhea USDC/wNEAR pool pricing NEAR for the cap (default 1900 testnet, 4512 mainnet)
PRICE_POOL_ID=

# api: HS256 session key, at least 32 bytes
SESSION_SECRET=
SESSION_TTL=24h
SLIPPAGE_BPS=50
CORS_ORIGINS=http://localhost:3000
# NEAR Intents 1Click (optional JWT, docs/STACK.md); dry quotes only
INTENTS_JWT=

# postgres + redis (compose builds DATABASE_URL from POSTGRES_* itself)
POSTGRES_USER=nearly
POSTGRES_PASSWORD=nearly
POSTGRES_DB=nearly
DATABASE_URL=postgres://nearly:nearly@localhost:5432/nearly?sslmode=disable
REDIS_URL=redis://localhost:6379
# host runs only; compose wires service URLs itself
EXECUTOR_URL=http://localhost:8083
MARKET_DATA_URL=http://localhost:8082

# compose-only tuning (optional)
API_PORT=8080
MARKET_DATA_PORT=8082
HISTORY_PORT=8087
MARKET_POLL_EVERY=30s
POOL_IDS=
SCHEDULER_TICK=10s
HISTORY_NETWORK=mainnet
HISTORY_INGEST=true
HISTORY_BACKFILL_DAYS=180
INDEXER_START_HEIGHT=0
INDEXER_POLL_EVERY=5s
INDEXER_MAX_LAG=600
LOG_LEVEL=info
