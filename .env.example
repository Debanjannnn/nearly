# network: testnet | mainnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# root account that owns the factory, e.g. nearly.testnet
NEARLY_ROOT_ACCOUNT=
# executor function-call key (never commit the real value)
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=
INTERNAL_SECRET=
MAX_STEP_USD=
# optional: Rhea USDC/wNEAR pool pricing NEAR for the cap (default 1900 testnet, 4512 mainnet)
PRICE_POOL_ID=
# NEAR Intents 1Click (optional JWT, see HACKATHON.md Q-006)
INTENTS_JWT=
DATABASE_URL=postgres://nearly:nearly@localhost:5432/nearly?sslmode=disable
REDIS_URL=redis://localhost:6379
# scheduler reads quotes + freshness from market-data
MARKET_DATA_URL=http://localhost:8082
